# CMake and build-tool intermediates
build/

# Distribution binaries are generated; keep only the directory marker.
dist/binary/*
!dist/binary/.gitkeep

# Packaging staging and generated release metadata
dist/staging/
dist/*.wixpdb
dist/*.exe
dist/*.msi

# Local IDE and Python files
*.user
*.suo
*.log
__pycache__/
*.py[cod]
