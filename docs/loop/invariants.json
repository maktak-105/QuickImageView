{
  "schema_version": 1,
  "project": "QuickImageView",
  "invariants": [
    {
      "id": "file_info_display",
      "description": "画像ファイル名、寸法、形式、ファイルサイズを表示し続ける",
      "source_probes": ["MetadataText", "g_fileSize", "g_imageWidth", "g_imageHeight", "DrawTextW"]
    },
    {
      "id": "exif_display",
      "description": "代表的なEXIF情報を読み取り、画面に表示し続ける",
      "source_probes": ["ReadExif", "g_exifMake", "g_exifModel", "g_exifDateTime", "ExifText", "GetMetadataQueryReader"]
    },
    {
      "id": "source_preservation",
      "description": "原本を変更・削除・上書きしない",
      "source_probes": ["SamePath", "CREATE_NEW", "原本は変更していません"]
    },
    {
      "id": "context_menu_safety",
      "description": "Explorer登録はQIV専用キーだけを扱い、アンインストールで他の登録を削除しない",
      "source_probes": ["SystemFileAssociations\\image\\shell\\QuickImageView"]
    }
  ]
}
